# Public origin, used for the sitemap and share previews. Optional on Vercel,
# where it defaults to the project's production domain.
SITE_URL=

# Admin sign-in ------------------------------------------------------------
ADMIN_USERNAME=
# bcrypt hash — generate with: node scripts/hash-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# MongoDB ------------------------------------------------------------------
# Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
# Optional — defaults to "hs_architects"
MONGODB_DB=

# Cloudinary ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
